# Telegram API credentials
# Get these from https://my.telegram.org/apps
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Source chat: the bot or chat to monitor for messages
# Can be a username (with or without @) or numeric ID
# Examples: @SomeSignalBot, SomeSignalBot, -1001234567890
SOURCE_CHAT=@your_source_bot

# Destination chat: where to send extracted contract addresses
# Can be a username, numeric ID, or "me" for Saved Messages
# Examples: @MyChannel, -1001234567890, me
DESTINATION_CHAT=me
